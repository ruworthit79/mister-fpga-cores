# --------------------------------------------------------------------------
#  Quadra950_MiSTer - core source manifest
#
#  Add new RTL files here (NOT via the Quartus IDE, which rewrites the .qsf).
#  Chip names follow the real Quadra 900/950 silicon (Apple Developer Note),
#  NOT the later Centris/Quadra 610/650/800 "Wombat" parts (djMEMC/IOSB).
# --------------------------------------------------------------------------

# Top level (emu module wrapper)
set_global_assignment -name SYSTEMVERILOG_FILE Quadra950.sv
set_global_assignment -name SDC_FILE Quadra950.sdc

# System integration
set_global_assignment -name SYSTEMVERILOG_FILE rtl/quadra950.sv

# System PLL (Altera PLL IP, entities `pll`/`pll_0002`): Quadra950.sv instantiates
# `pll pll` at 50 MHz (rtl/pll/pll_0002.v). Do NOT add rtl/pll.qip here - the
# MiSTer framework already includes it: sys/sys.qip pulls in sys/pll_q<ver>.qip,
# whose first line is `QIP_FILE rtl/pll.qip`. Listing it again defines the `pll`
# entity twice and fails the Quartus compile (duplicate entity).

# CPU: TG68 kernel (VHDL, LGPLv3) + bus adapter, instantiated by quadra950.sv
# (Quartus mixed-language: a Verilog module may instantiate the VHDL entity.)
set_global_assignment -name VHDL_FILE rtl/cpu/tg68k/TG68K_Pack.vhd
set_global_assignment -name VHDL_FILE rtl/cpu/tg68k/TG68K_ALU.vhd
set_global_assignment -name VHDL_FILE rtl/cpu/tg68k/TG68KdotC_Kernel.vhd
# 68040 FPU (VHDL) - instantiated by cpu_wrapper (fpu : fpu_040), so it MUST be
# compiled BEFORE cpu_wrapper.vhd for the VHDL elaboration to resolve.
set_global_assignment -name VHDL_FILE rtl/cpu/fpu_040.vhd
set_global_assignment -name VHDL_FILE rtl/cpu/cpu_wrapper.vhd

# Phase 5 (68040) MMU interface anchor - present but not yet instantiated by
# cpu_wrapper (see docs/PHASE5_SCOPE.md). Uncomment when integration begins.
# set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/mmu_040.sv

# Chipset - real Quadra 900/950 custom ICs
set_global_assignment -name SYSTEMVERILOG_FILE rtl/chipset/mcu.sv      ;# Memory Control Unit
set_global_assignment -name SYSTEMVERILOG_FILE rtl/chipset/iobus.sv    ;# JDB + Relayer I/O bus adapter
set_global_assignment -name SYSTEMVERILOG_FILE rtl/chipset/via.sv      ;# VIA1 / VIA2
set_global_assignment -name SYSTEMVERILOG_FILE rtl/chipset/caboose.sv  ;# RTC / PRAM / power (68HC05)
set_global_assignment -name SYSTEMVERILOG_FILE rtl/chipset/yancc.sv    ;# NuBus controller

# Video
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video/dafb.sv       ;# Direct Access Frame Buffer

# Audio
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/asc.sv        ;# Enhanced Apple Sound Chip (+DFAC)

# I/O peripherals
set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/iop.sv           ;# 6502-based I/O processor
set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/scsi_ncr53c96.sv ;# dual NCR 53C96 SCSI
set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/swim.sv          ;# SWIM floppy controller
set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/adb.sv           ;# Apple Desktop Bus (via IOP)
set_global_assignment -name SYSTEMVERILOG_FILE rtl/io/sonic.sv         ;# SONIC DP83932 Ethernet
